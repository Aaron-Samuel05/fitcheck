# Database
# Use MongoDB Atlas (or another persistent MongoDB) in production.
MONGO_URL=mongodb://localhost:27017
DB_NAME=fitcheck

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TTL_MIN=60
REFRESH_TTL_DAYS=30
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
COOKIE_SECURE=true

# Native Google OpenID Connect (Google Cloud OAuth Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fitcheck-org.vercel.app/api/auth/google/callback

# AI Buddy provider
# Keep this server-side; never commit the real key.
EMERGENT_LLM_KEY=
FITCHECK_AI_MODEL=gemini-3-flash-preview
FREE_AI_DAILY_LIMIT=5

# Frontend / CORS
FRONTEND_URL=https://fitcheck-org.vercel.app
CORS_ORIGINS=http://localhost:3000,https://fitcheck-org.vercel.app

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUDDY_PRO_MONTHLY=
STRIPE_PRICE_BUDDY_PRO_YEARLY=
