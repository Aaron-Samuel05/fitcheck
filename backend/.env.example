# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=fitcheck

# Authentication - use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TTL_MIN=60
REFRESH_TTL_DAYS=30

# Emergent Universal LLM key (keep this server-side; never commit the real key)
EMERGENT_LLM_KEY=
FITCHECK_AI_MODEL=gemini-3-flash-preview

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,https://fitcheck-org.vercel.app
