# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=fitcheck

# Authentication - use a long random value in production
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TTL_MIN=60
REFRESH_TTL_DAYS=30

# Emergent Universal LLM key (keep this server-side; never commit the real key)
EMERGENT_LLM_KEY=
FITCHECK_AI_MODEL=gemini-3-flash-preview
FREE_AI_DAILY_LIMIT=5

# Frontend / CORS
FRONTEND_URL=https://fitcheck-org.vercel.app
CORS_ORIGINS=http://localhost:3000,https://fitcheck-org.vercel.app

# Google auth broker signing key. Must match the auth provider's signed session token configuration.
GOOGLE_SESSION_SIGNING_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUDDY_PRO_MONTHLY=
STRIPE_PRICE_BUDDY_PRO_YEARLY=
